# SMTP server details (Gmail example; use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-sending-account@gmail.com
SMTP_PASSWORD=your-app-password

# The sender should be an address permitted by your SMTP provider.
SMTP_FROM_EMAIL=your-sending-account@gmail.com

# Inbox that should receive contact form messages.
CONTACT_TO_EMAIL=your-business-inbox@example.com

# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

LOG_LEVEL=INFO

# Frontend setting (put this in the website root .env.local, not in this backend .env):
# NEXT_PUBLIC_CONTACT_API_URL=http://localhost:8000
